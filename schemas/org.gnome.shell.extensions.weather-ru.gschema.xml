<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.weather-ru" path="/org/gnome/shell/extensions/weather-ru/">
    <key name="language" type="s"><choices><choice value="ru"/><choice value="en"/><choice value="de"/><choice value="fr"/><choice value="es"/><choice value="it"/><choice value="pt"/><choice value="pl"/><choice value="uk"/><choice value="tr"/><choice value="ar"/><choice value="hi"/><choice value="zh"/><choice value="ja"/><choice value="ko"/><choice value="vi"/><choice value="id"/><choice value="th"/></choices><default>"en"</default><summary>Interface language</summary><description>Supported interface locale code</description></key>
